# === TigerAI Advanced RAG — Community Edition ===
# Connect to your OpenGenie AI Stack services. Match host names to your stack's
# container names / network, then:  cp .env.example .env

# Server
PORT=3060
NODE_ENV=production

# Public base URL — used for the downloadable source-citation links in answers.
# Must be reachable by your users (do NOT leave as localhost on a remote host).
PUBLIC_URL=http://localhost:8088

# Host port for the TigerAI Web UI (defaults to 8088 if unset). Set this if the
# default port is occupied on your machine (e.g. by cAdvisor).
# HOST_UI_PORT=8888

# PostgreSQL (projects / rules / keywords / chat-apps metadata)
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=changeme
PG_DATABASE=tigerai

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=2

# n8n
N8N_HOST=n8n
N8N_PORT=5678

# Open WebUI
OWUI_BASE_URL=http://open-webui:8080
OWUI_API_KEY=

# Docling (PDF -> Markdown)
# NOTE: The host name must match the actual Docling container name from your
# OpenGenie stack — common names are 'docling-serve' or 'docling-intel'.
# Verify with `docker ps` and adjust DOCLING_BASE_URL accordingly.
DOCLING_BASE_URL=http://docling:5001

# Qdrant (vector DB) — can also be set in the UI (07.System Settings)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# PDF Splitter (this app's own container)
SPLITTER_BASE_URL=http://tigerai-splitter:8000

# FileBrowser (optional)
# ⚠️ Recent FileBrowser versions ENFORCE a minimum password length of 12+ chars
# (and reject weak / common passwords). 'admin' / 'changeme' / short or simple
# passwords WILL be silently rejected by the FileBrowser engine and login fails.
# Set a real ≥12-char password here AND match it in your FileBrowser admin UI.
FB_HOST=filebrowser
FB_PORT=80
FB_USERNAME=admin
FB_PASSWORD=ChangeMeToALongPassword!2026
