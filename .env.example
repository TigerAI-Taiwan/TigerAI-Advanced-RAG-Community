# === TigerAI Advanced RAG — Community Edition ===
# v1.0.15  2026-05-31  補齊 15 個 backend 實際讀取但未列出的 env、加分組、加預設密碼警告
# Connect to your OpenGenie AI Stack services. Match host names to your stack's
# container names / network, then:  cp .env.example .env

# ─────────────────────────────────────────────────────────────────────────────
# Server  (Express backend listener + 對外連結 + body 上限)
# ─────────────────────────────────────────────────────────────────────────────
PORT=3060
NODE_ENV=production

# Edition tag — community / webapp / advanced。Community 版固定 community。
TIGERAI_EDITION=community

# Public base URL — used for the downloadable source-citation links in answers.
# Must be reachable by your users (do NOT leave as localhost on a remote host).
PUBLIC_URL=http://localhost:8088

# Host port for the TigerAI Web UI (defaults to 8088 if unset). Set this if the
# default port is occupied on your machine (e.g. by cAdvisor).
# HOST_UI_PORT=8888

# Express JSON body limit (大型 chunk / 規則上傳時需要放大)
JSON_BODY_LIMIT=50mb

# n8n / splitter callback 回打 backend 用的內部 URL（容器內 DNS 名稱）
BACKEND_INTERNAL_URL=http://tigerai-backend:3060

# Portal（外部入口，可選；未啟用 portal 可留預設）
# PORTAL_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# DB — PostgreSQL (projects / rules / keywords / chat-apps metadata)
# ─────────────────────────────────────────────────────────────────────────────
PG_HOST=postgres
PG_PORT=5432
PG_USER=adm
# ⚠️  正式環境必須改為強隨機密碼；預設值 `tigerai` 僅供本機開發測試
PG_PASSWORD=tigerai
PG_DATABASE=tigerai
# v1.0.18: DB schema 名稱。同一個 PostgreSQL instance 上跑多個 edition / staging
# 時必須各自獨立(community / webapp / advanced),否則 settings / projects 互相污染。
# 預設 tigerai_webapp(向後相容);Community 建議設 tigerai_community。
PG_SCHEMA=tigerai_webapp

# ─────────────────────────────────────────────────────────────────────────────
# Redis  (佇列 / 快取)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=2

# ─────────────────────────────────────────────────────────────────────────────
# n8n  (workflow 引擎；自動部署/啟用/更新 workflow 需要 API Key)
# ─────────────────────────────────────────────────────────────────────────────
N8N_HOST=n8n-main
N8N_PORT=5678
# n8n Personal API Key — 權限至少需含 workflows:* (read/create/update/activate)
# 與 credentials:read。在 n8n UI: Settings → API → Create an API key。
N8N_API_KEY=
# v1.0.18: 共用同一個 n8n instance 跑多 edition 時開啟,backend 改打
# /webhook/tigerai-{edition}-stepN(deploy_n8n.py 用 --webhook-prefix 對應改 workflow webhook path),
# 跟別的 edition / 既有部署的 /webhook/tigerai-stepN 不撞。獨立 n8n 不需設(留空 = 用無前綴路徑)。
# WEBHOOK_PREFIX=1

# ─────────────────────────────────────────────────────────────────────────────
# Upstream Services  (HOST/PORT for nginx proxy paths: /api/, /n8n-webhook/,
# /qdrant/, /owui/, /docling/). Every OpenGenie deployment names its containers
# slightly differently — set these to match `docker ps` output on YOUR stack.
# (Hardcoded defaults previously broke custom stacks with 502 Bad Gateway.)
#
# These also drive the backend's URLs below — keep both in sync if you change
# anything (Express backend currently reads BASE_URLs directly).
# ─────────────────────────────────────────────────────────────────────────────

# Open WebUI
# v1.0.16 2026-05-31: OWUI_API_KEY 不再是「必須 startup 時設好」— backend 現已動態讀
# appConfig.owui_key(Tab 07 可即時改不用重啟)。但首次 chat-app 建立前必須有 key,
# 否則 "OWUI Pipeline 建立失敗"。建議:啟動後到 Tab 07 OpenWebUI API Key 設好即可。
OWUI_HOST=openwebui-main
OWUI_PORT=8080
OWUI_BASE_URL=http://openwebui-main:8080
OWUI_API_KEY=
# OWUI pipe 樣板 ID(自動建立 chat-app 時複製此 pipe;預設 n8n_v2,可選)
# 注意:OWUI 上必須先有 id=n8n_v2 的 pipeline 模板,否則 createOwuiPipeline 拿不到
# template 會 return null。fresh install 需手動到 OWUI Admin → Functions 匯入。
# OWUI_TEMPLATE_PIPE_ID=n8n_v2

# Docling (PDF -> Markdown)
# Common alternative names in OpenGenie stacks: 'docling-serve', 'docling-intel'.
# Verify with `docker ps` and set BOTH the HOST/PORT and BASE_URL to match.
DOCLING_HOST=docling
DOCLING_PORT=5001
DOCLING_BASE_URL=http://docling:5001

# Qdrant (vector DB) — can also be set in the UI (07.System Settings)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# PDF Splitter (this app's own container)
SPLITTER_BASE_URL=http://tigerai-splitter:8000

# FileBrowser (optional)
# ⚠️ Recent FileBrowser versions ENFORCE a minimum password length of 12+ chars
# (and reject weak / common passwords). 'admin' / 'changeme' / short or simple
# passwords WILL be silently rejected by the FileBrowser engine and login fails.
# Set a real ≥12-char password here AND match it in your FileBrowser admin UI.
FB_HOST=filebrowser
FB_PORT=80
FB_USERNAME=admin
# ⚠️  正式環境必須改為強隨機密碼（≥12 字元）；預設值僅供本機開發測試
FB_PASSWORD=ChangeMeToALongPassword!2026

# ─────────────────────────────────────────────────────────────────────────────
# AI Provider  (雲端 API 或地端推論)
# ─────────────────────────────────────────────────────────────────────────────
# cloud = 用雲端 LLM API；local = 用地端推論（ollama / llamacpp / vllm）
AI_PROVIDER=cloud
# 地端推論型態（AI_PROVIDER=local 時生效）
#   ollama  → /api/*
#   llamacpp / vllm → OpenAI-compatible /v1/*
LOCAL_AI_TYPE=ollama
# 地端推論 base URL（沿用 OLLAMA_URL 欄位名，實際是「地端 base URL」）
OLLAMA_URL=http://ollama:11434

# ─────────────────────────────────────────────────────────────────────────────
# RAG Files  (PDF / Markdown / 切片產物的容器內掛載根)
# ─────────────────────────────────────────────────────────────────────────────
SPLITTER_FILES_ROOT=/srv/RAG

# ─────────────────────────────────────────────────────────────────────────────
# Security  (加密金鑰 / 設定簽章 / 跨服務傳輸密鑰)
# ─────────────────────────────────────────────────────────────────────────────
# 對稱加密金鑰檔（用於加密 DB 內 API key 等敏感欄位）。預設 /app/.cipher_key。
# 容器首次啟動會自動產生；如要自帶可掛載到此路徑後設定此變數。
# CIPHER_KEY_FILE=/app/.cipher_key

# ⚠️  SETTINGS_SECRET — 設定檔簽章/驗章用，必須是強隨機字串
#     正式環境請用： openssl rand -hex 32   產生後填入；切勿沿用範例值
SETTINGS_SECRET=

# ⚠️  TRANSIT_SECRET — 跨服務傳輸 payload 簽章用，必須是強隨機字串
#     未設定時 backend 啟動會自動產生（但每次重啟會變、無法跨實例共享）
#     正式環境請用： openssl rand -hex 32   產生後填入並所有實例一致
TRANSIT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Deployment  (容器 user / image registry)
# ─────────────────────────────────────────────────────────────────────────────
# 容器內 process 跑的 uid:gid（對應 host 上掛載目錄擁有者，避免權限不一致）
PUID=1000
PGID=1000

# Image registry / namespace prefix（docker-compose 拉 image 用）
TIGERAI_IMAGE_PREFIX=ghcr.io/tigerai-taiwan
