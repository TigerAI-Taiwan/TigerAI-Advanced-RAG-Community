# === TigerAI Advanced RAG — Community Edition ===
# Connect to your OpenGenie AI Stack services. Match host names to your stack's
# container names / network, then:  cp .env.example .env

# Server
PORT=3060
NODE_ENV=production

# Public base URL — used for the downloadable source-citation links in answers.
# Must be reachable by your users (do NOT leave as localhost on a remote host).
PUBLIC_URL=http://localhost:8088

# PostgreSQL (projects / rules / keywords / chat-apps metadata)
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=changeme
PG_DATABASE=tigerai

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=2

# n8n
N8N_HOST=n8n
N8N_PORT=5678

# Open WebUI
OWUI_BASE_URL=http://open-webui:8080
OWUI_API_KEY=

# Docling (PDF -> Markdown)
DOCLING_BASE_URL=http://docling:5001

# Qdrant (vector DB) — can also be set in the UI (07.System Settings)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# PDF Splitter (this app's own container)
SPLITTER_BASE_URL=http://tigerai-splitter:8000

# FileBrowser (optional)
FB_HOST=filebrowser
FB_PORT=80
FB_USERNAME=admin
FB_PASSWORD=changeme
