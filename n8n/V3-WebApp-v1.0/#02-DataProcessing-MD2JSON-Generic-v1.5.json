    {
      "parameters": {
        "jsCode": "// v1.2 Parse LLM output from either Ollama or OpenAI-compatible Cloud AI.\n// Ollama returns { message: { content } }; OpenAI returns { choices: [{ message: { content } }] }.\nconst vars = $('Extract Payload').first().json;\nconst llmItems = $input.all();\nconst fileItems = $('Loop Per File').all();\n\nreturn llmItems.map((r, i) => {\n  const rawContent = r.json.output\n    || r.json.message?.content\n    || r.json.choices?.[0]?.message?.content\n    || r.json.response\n    || '';\n  // Strip any accidental markdown code fences (``` or ```json)\n  let cleaned = rawContent.trim().replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/i, '').trim();\n  let parsed;\n  try {\n    parsed = JSON.parse(cleaned);\n  } catch (e) {\n    const match = cleaned.match(/\\[[\\s\\S]*\\]/);\n    if (!match) throw new Error(`LLM returned non-JSON: ${cleaned.substring(0, 200)}`);\n    parsed = JSON.parse(match[0]);\n  }\n  if (!Array.isArray(parsed)) throw new Error('Expected JSON array from LLM');\n\n  const sourceFile = fileItems[i]?.binary?.data?.fileName\n    || fileItems[i]?.json?.fileName\n    || fileItems[i]?.json?.name\n    || `chunk_${i}.md`;\n  parsed = parsed.map(chunk => ({\n    ...chunk,\n    metadata: { ...(chunk.metadata || {}), source_file: sourceFile }\n  }));\n\n  const outputName = sourceFile.replace(/\\.md$/i, '.json');\n  return {\n    json: { file_name: outputName, chunk_count: parsed.length },\n    binary: {\n      data: {\n        data: Buffer.from(JSON.stringify(parsed, null, 2)).toString('base64'),\n        mimeType: 'application/json',\n        fileName: outputName\n      }\n    }\n  };\n});"
      },
