      "id": "n-extract-txt",
      "name": "Extract MD Text",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        520,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// v1.4 2026-04-21: 用 Extract From File 原生 node 的 md_text 輸出（它會正確處理 filesystem binary mode）。\n// 檔名 prefix 直接用 payload 帶進來的 project_name。\nconst items = $input.all();\nconst projectName = $('Extract Payload').first().json.project_name || 'unknown';\nconst charLimit = 25000;\nconst perFile = Math.max(1500, Math.floor(charLimit / Math.max(1, items.length)));\nlet combined = '';\nlet remaining = charLimit;\nconst fileNames = [];\nfor (const it of items) {\n  if (remaining <= 0) break;\n  const name = it.binary?.data?.fileName || it.json?.fileName || 'unknown.md';\n  const content = (it.json?.md_text || '').toString();\n  if (!content) continue;\n  const slice = content.length > perFile ? content.substring(0, perFile) + '\\n...[truncated]' : content;\n  combined += `\\n\\n===== FILE: ${name} =====\\n${slice}`;\n  remaining -= slice.length;\n  fileNames.push(name);\n}\nif (!combined) throw new Error('Extract From File 沒抽出任何文字');\nreturn [{ json: { combined, file_count: fileNames.length, files: fileNames, prefix: projectName } }];"
      },
      "id": "n-merge",
      "name": "Merge MD Contents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cp1",
              "leftValue": "={{ $('Extract Payload').first().json.ai_provider }}",
              "rightValue": "local",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "n-if-provider",
      "name": "Use Ollama?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        800,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// v1.2 Accept both Ollama and OpenAI-compatible response shapes\nconst r = $input.first().json;\nconst raw = r.message?.content || r.choices?.[0]?.message?.content || r.response || '';\nlet s = raw.trim().replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/i, '').trim();\nlet parsed;\ntry { parsed = JSON.parse(s); }\ncatch (e) {\n  const m = s.match(/\\[[\\s\\S]*\\]/);\n  if (!m) throw new Error('LLM returned non-JSON: ' + s.substring(0, 200));\n  parsed = JSON.parse(m[0]);\n}\nif (!Array.isArray(parsed)) throw new Error('Expected JSON array');\nreturn [{ json: { questions: parsed, count: parsed.length } }];"
      },
      "id": "n-parse",
      "name": "Parse QA JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// v1.4 2026-04-21: 檔名 prefix 直接吃 payload 帶進來的 project_name（Merge 節點已轉給 $json.prefix）\nconst qa = $input.first().json.questions || [];\nconst prefix = $('Merge MD Contents').first().json.prefix || 'unknown';\nconst outName = `${prefix}-000-manual-test-qa.json`;\nconst pretty = JSON.stringify(qa, null, 2);\nreturn [{\n  json: { file_name: outName, count: qa.length, questions: qa },\n  binary: {\n    data: {\n      data: Buffer.from(pretty, 'utf8').toString('base64'),\n      mimeType: 'application/json',\n      fileName: outName\n    }\n  }\n}];"
      },
      "id": "n-build-qa-file",
      "name": "Build QA JSON File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1400,
        300
      ]
    },
