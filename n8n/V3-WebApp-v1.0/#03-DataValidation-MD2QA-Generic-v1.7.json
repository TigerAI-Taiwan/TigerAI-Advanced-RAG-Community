              "value": "={{ $json.combined }}",
              "type": "string"
            },
            {
              "id": "sp",
              "name": "system_prompt",
              "value": "=你是 RAG 知識庫的驗證專家。根據提供的文件內容，產出 {{ $('Extract Payload').first().json.question_count }} 道人工驗證用問答題。\n\n嚴格輸出要求：\n- 只輸出合法 JSON 陣列（Array），不要任何 markdown code fence、前言或後記。\n- 每個元素為物件：{\"question\": \"...\", \"expected_answer\": \"...\", \"source_file\": \"...\"}\n- question 用口語化問句（像人類實際會問的）。\n- expected_answer 必須基於原始文件可驗證的事實，1~3 句話精煉說明。\n- source_file 指出該題主要引用的檔名（來自 ===== FILE: xxx ===== 標頭）。\n- 涵蓋不同檔案 / 不同主題，避免壓在同一份文件。",
              "type": "string"
            },
            {
              "id": "md",
              "name": "model",
              "value": "={{ $('Extract Payload').first().json.ai_provider === 'local' ? $('Extract Payload').first().json.ollama_main_model : $('Extract Payload').first().json.cloud_ai_model }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
