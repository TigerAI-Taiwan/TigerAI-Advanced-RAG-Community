      "id": "n_parse",
      "name": "Parse JSON",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        640,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// v1.0 2026-05-23: 每個來源檔 → 一個 QC 判定項目（含 prompt）\n// chunk JSON 經 Extract From File(fromJson) 後，陣列可能在 $json 或 $json.data（沿用 #04 偵測法）\nconst vars = $('Extract Payload').first().json;\nconst passScore = vars.qc_pass_score || '70';\nconst promptTpl = vars.qc_prompt || '請審查下列 chunk，回傳 JSON {verdict,score,issues,summary}。{chunks}';\nconst out = [];\nfor (const item of $input.all()) {\n  let chunks;\n  if (Array.isArray(item.json)) chunks = item.json;\n  else if (Array.isArray(item.json.data)) chunks = item.json.data;\n  else if (item.json.text) chunks = [item.json];\n  else continue;\n  const sourceFile = chunks[0]?.metadata?.source_file || item.json.file_name || '';\n  const fileName = sourceFile.replace(/\\.(md|markdown)$/i, '.json');\n  if (!fileName) continue;\n  const chunksJson = JSON.stringify(chunks, null, 1).slice(0, 40000);\n  const prompt = promptTpl.replace('{pass_score}', String(passScore)).replace('{chunks}', chunksJson);\n  out.push({ json: { file_name: fileName, chunk_count: chunks.length, prompt } });\n}\n// 沒有任何 chunk 檔 → 放一個 PASS 佔位，讓流程能走到 callback 觸發 Step4（不卡住）\nif (out.length === 0) {\n  return [{ json: { file_name: '', chunk_count: 0, prompt: 'No chunks. Reply exactly: {\"verdict\":\"PASS\",\"score\":100,\"issues\":[],\"summary\":\"no chunk files\"}' } }];\n}\nreturn out;\n"
      },
      "id": "n_buildqc",
      "name": "Build QC Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        300
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.prompt }}",
        "options": {
          "systemMessage": "你是嚴格的 RAG chunk 品質審查員。只輸出一個合法 JSON 物件，不要任何其他文字、不要 markdown 圍欄。格式：{\"verdict\":\"PASS\"|\"FAIL\",\"score\":<0-100整數>,\"issues\":[{\"severity\":\"high\"|\"medium\"|\"low\",\"category\":\"...\",\"description\":\"...\"}],\"summary\":\"...\"}"
        }
      },
      "id": "n_judge",
      "name": "QC Judge",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1060,
        300
      ]
    },
    {
      "parameters": {
        "model": "gpt-5.4-mini",
        "options": {
          "temperature": 0.1
        }
      },
      "id": "n_llm",
      "name": "OpenAI Chat (QC)",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [
        1060,
        520
      ],
      "credentials": {
        "openAiApi": {
          "id": "j9NcDQ1CpW9X6v2Z",
          "name": "OpenAiaccount"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// v1.0 2026-05-23: 解析 QC Judge 輸出 → {file_name,verdict,score,issues,summary}\n// 解析失敗 / LLM 異常 → fallback PASS（不擋流程，留 issue 記錄）；二次判斷 high issue 或低分降 FAIL\nconst inputs = $('Build QC Input').all();\nconst passScore = parseInt($('Extract Payload').first().json.qc_pass_score || '70', 10);\nreturn $input.all().map((item, i) => {\n  const fileName = inputs[i]?.json?.file_name || '';\n  const raw = item.json.output ?? item.json.text ?? '';\n  let parsed = null;\n  try {\n    const s = String(raw).trim().replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/i, '').trim();\n    parsed = JSON.parse(s);\n  } catch (e) {\n    const m = String(raw).match(/\\{[\\s\\S]*\\}/);\n    try { parsed = m ? JSON.parse(m[0]) : null; } catch (e2) { parsed = null; }\n  }\n  if (!parsed || typeof parsed !== 'object') {\n    parsed = { verdict: 'PASS', score: 0, issues: [{ severity: 'medium', category: 'qc_parse_error', description: 'QC 輸出無法解析，預設放行' }], summary: 'QC parse error, defaulted PASS' };\n  }\n  const hasHigh = (parsed.issues || []).some(x => x && x.severity === 'high');\n  let verdict = parsed.verdict === 'FAIL' ? 'FAIL' : 'PASS';\n  if (verdict === 'PASS' && (hasHigh || (Number.isFinite(parsed.score) && parsed.score < passScore))) verdict = 'FAIL';\n  return { json: { file_name: fileName, verdict, score: Number.isFinite(parsed.score) ? parsed.score : null, issues: parsed.issues || [], summary: parsed.summary || '' } };\n});\n"
      },
