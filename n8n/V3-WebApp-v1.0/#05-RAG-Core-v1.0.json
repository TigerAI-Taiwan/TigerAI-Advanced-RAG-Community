            {
              "id": "g1",
              "name": "context",
              "value": "={{ (($input.first().json.result) || []).map((h, i) => '[' + (i+1) + '] (score=' + (typeof h.score === 'number' ? h.score.toFixed(3) : '-') + (h.payload && (h.payload.original_file || h.payload.source_file) ? ', ' + (h.payload.original_file || h.payload.source_file) : '') + ')\\n' + ((h.payload && h.payload.text) || '')).join('\\n\\n') }}",
              "type": "string"
            },
            {
              "id": "g2",
              "name": "hits",
              "value": "={{ (($input.first().json.result) || []).length }}",
              "type": "number"
            },
            {
              "id": "g3",
              "name": "sources",
              "value": "={{ (($input.first().json.result) || []).map(h => (h.payload && (h.payload.original_file || h.payload.source_file))).filter(Boolean) }}",
              "type": "array"
            },
            {
              "id": "refmd",
              "name": "references_md",
              "value": "={{ (() => { const r = (($input.first().json.result) || []); const seen = new Set(); const lines = []; for (const h of r) { const p = h.payload || {}; const key = p.original_file || p.source_file; if (!key || seen.has(key)) continue; seen.add(key); const su = p.source_url, mu = p.md_url; if (!su && !mu) continue; let line = '- ' + key; if (su) line += '：[📄 原始檔](' + su + ')'; if (mu) line += ' ｜ [📝 轉譯MD](' + mu + ')'; lines.push(line); if (lines.length >= 5) break; } return lines.length ? '\n\n---\n**📎 參考來源（可下載）**\n' + lines.join('\n') : ''; })() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "n-context",
      "name": "Build RAG Context",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1792,
        64
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "uc",
              "name": "user_content",
              "value": "=問題：{{ $('Build Context Vars').item.json.chatInput }}\n\nRetrieved Context:\n{{ $json.context }}\n\n請依下方三段式格式作答（繁體中文）。",
              "type": "string"
            },
            {
              "id": "sp",
              "name": "system_prompt",
              "value": "={{ $('Build Context Vars').item.json.system_prompt }}\n\n# 輸出格式（嚴格遵守，繁體中文）\n必須用以下三段式 Markdown 標題輸出，順序不可顛倒：\n\n### 1. 引用條款\n逐條引用 Retrieved Context 原文（含條號/章節名），用 > 引述。有幾條列幾條。若 Context 沒有可引用條文 → 「文件內未提及」。\n\n### 2. 說明\n用自己的話解釋上述條款如何套用到提問（不重複原文）。\n\n### 3. 建議作法\n列 1~5 點 bullet list。文件不足時寫「依現有文件無法給出可靠建議，請補充相關條文或向專業人士諮詢。」\n\n### 4. 建議追問\n根據提問與 Retrieved Context，最後列出 2~3 個使用者可能接著想問的問題（繁體中文、具體、可直接點問）。優先採用 Context 中 chunk 自帶的 suggested_questions；無則依主題自擬。格式：\n- 問題一？\n- 問題二？",
              "type": "string"
            },
            {
              "id": "md",
              "name": "model",
              "value": "={{ $('Build Context Vars').item.json.ai_provider === 'local' ? $('Fetch Backend Config').item.json.ollama_main_model : $('Fetch Backend Config').item.json.cloud_ai_model }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "bli05",
      "name": "Build LLM Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1984,
        64
      ]
    },
    {
      "parameters": {
        "jsCode": "// 確定性「字面」關鍵字比對(子字串)。字典詞真的出現在問題裡 → literal_hit,直接認定命中(不靠 LLM)。\nconst cv = $input.first().json;\nconst q = String(cv.chatInput || '');\nconst dict = [];\n['L1', 'L2', 'L3'].forEach(k => { String(cv[k] || '').split(/[、,，;；\\s]+/).forEach(w => { w = w.trim(); if (w && w !== '(無)') dict.push(w); }); });\nconst literal = [...new Set(dict.filter(w => w.length >= 2 && q.includes(w)))];\nreturn [{ json: { ...cv, literal_hit: literal.length > 0, literal_keywords: literal } }];"
      },
      "id": "lit-match",
      "name": "Literal Keyword Match",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
