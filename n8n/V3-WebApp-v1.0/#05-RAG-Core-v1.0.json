    {
      "parameters": {
        "jsCode": "// 解析 Agent1 的 #1 關鍵字 行，並合併前一步程式確定的字面命中\nconst raw = $json.output || '';\nconst m = raw.match(/#1\\s*關鍵字\\s*[:：]\\s*(.+?)(?:\\n|$)/);\nconst fromLLM = m ? m[1].split(/[、,，;；\\s]+/).map(s => s.trim()).filter(Boolean) : [];\nconst literal = $('Literal Keyword Match').first().json.literal_keywords || [];\nconst kws = [...new Set([...literal, ...fromLLM])];\nreturn [{ json: { keywords: kws } }];"
      },
      "id": "n-parse-kw",
      "name": "Parse Keywords",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        752,
        80
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Build Context Vars').item.json.ai_provider === 'local' ? ($('Build Context Vars').item.json.ollama_url + '/v1/embeddings') : ($('Build Context Vars').item.json.cloud_ai_url + '/embeddings') }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Build Context Vars').item.json.ai_provider === 'local' ? $('Build Context Vars').item.json.ollama_api_key : $('Build Context Vars').item.json.cloud_ai_key }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $('Build Context Vars').item.json.ai_provider === 'local' ? $('Build Context Vars').item.json.ollama_embedding_model : $('Build Context Vars').item.json.cloud_ai_embedding_model }}\",\n  \"input\": {{ JSON.stringify($('Build Context Vars').item.json.chatInput) }}\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "n-embed",
      "name": "Embed Query",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        944,
        80
      ]
    },
    {
      "parameters": {
        "jsCode": "// 組 Qdrant search body：keywords OR filter 跨多欄（TigerAI 攤平 payload）\nconst kws = $('Parse Keywords').first().json.keywords || [];\nconst embedResp = $input.first().json;\nlet vector = null;\nif (embedResp.data && Array.isArray(embedResp.data) && embedResp.data[0]?.embedding) vector = embedResp.data[0].embedding;\nelse if (embedResp.embedding) vector = embedResp.embedding;\nelse if (embedResp.embeddings) vector = Array.isArray(embedResp.embeddings[0]) ? embedResp.embeddings[0] : embedResp.embeddings;\nif (!vector) throw new Error('Embed 沒回 vector: ' + JSON.stringify(embedResp).substring(0,200));\nconst body = { vector, limit: 5, with_payload: true, with_vector: false };\nif (kws.length) {\n  const fields = ['tags','keywords','level1','level2','level3','metadata_tags','category','subcategory'];\n  const should = [];\n  for (const f of fields) { should.push({ key: f, match: { any: kws } }); for (const kw of kws) should.push({ key: f, match: { value: kw } }); }\n  body.filter = { should };\n}\nreturn [{ json: { qdrant_body: body, collection: $('Build Context Vars').item.json.collection_name } }];"
      },
      "id": "n-build-q",
      "name": "Build Qdrant Body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
        80
      ]
    },
